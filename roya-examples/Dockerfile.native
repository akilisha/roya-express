# Multi-stage native build
FROM ghcr.io/graalvm/graalvm-community:21 AS build
WORKDIR /workspace
COPY . /workspace

# Install native-image
RUN gu install native-image

# Build JAR first
RUN ./gradlew :roya-examples:build -x test --no-daemon

# Generate native image using Gradle native-image plugin
# Native-image configurations are provided by :roya-plugins:graalvm
RUN ./gradlew :roya-examples:nativeCompile --no-daemon

FROM gcr.io/distroless/cc-debian12 AS runtime
WORKDIR /app
COPY --from=build /workspace/roya-examples/build/native/nativeCompile/roya-example /app/roya-example
EXPOSE 3000
ENTRYPOINT ["/app/roya-example"]

