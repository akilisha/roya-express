# Multi-stage build: Build JAR, then run
FROM gradle:8-jdk21 AS builder
WORKDIR /workspace
COPY . /workspace
RUN ./gradlew :roya-examples:build -x test --no-daemon

FROM eclipse-temurin:21-jre AS runtime
WORKDIR /app

# Copy built JAR
COPY --from=builder /workspace/roya-examples/build/libs/roya-examples-1.0.0-SNAPSHOT.jar app.jar

EXPOSE 3000
ENTRYPOINT ["java","--enable-preview","-jar","/app/app.jar"]

